# Server-only. Never rename this to a NEXT_PUBLIC variable.
GOLDRUSH_API_KEY=replace-with-your-goldrush-api-key

# Optional server-only CoinGecko Demo API key. Keyless public requests also work
# but are more likely to be rate limited.
COINGECKO_API_KEY=

# OpenAI is not required or read by the current rule-only release. Any future
# optional provider enhancement must remain server-only and must not control
# financial arithmetic.
