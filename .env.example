# Server-only. Never rename this to a NEXT_PUBLIC variable.
GOLDRUSH_API_KEY=replace-with-your-goldrush-api-key

# Optional server-only CoinGecko Demo API key. Keyless public requests also work
# but are more likely to be rate limited.
COINGECKO_API_KEY=

# OpenAI is not required or read by the current rule-only release. Any future
# optional provider enhancement must remain server-only and must not control
# financial arithmetic.

# Optional public Base Sepolia contract address. This is not a secret. Leave it
# empty to keep report receipts unavailable.
NEXT_PUBLIC_BASE_SEPOLIA_REPORT_RECEIPT_ADDRESS=

# Optional server-only HTTPS endpoint that accepts feedback JSON, such as a
# Formspree-compatible form endpoint. Never expose this as NEXT_PUBLIC.
FEEDBACK_FORM_ENDPOINT=

# Optional public fallback contact shown as a mailto link when configured.
NEXT_PUBLIC_SUPPORT_EMAIL=
