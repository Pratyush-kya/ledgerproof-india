{
  "cases": [
    {
      "name": "handles 18-decimal ETH and optional cess",
      "includeCess": true,
      "events": [
        {
          "id": "eth-buy",
          "day": 1,
          "deltas": [
            { "asset": "ETH", "direction": "in", "amountAtomic": "1000000000000000000" }
          ],
          "fiatFlow": { "direction": "paid", "amountInrPaisa": "100000" },
          "gasFeeWei": "21000",
          "gasValueInrPaisa": "500"
        },
        {
          "id": "eth-sell-half",
          "day": 2,
          "deltas": [
            { "asset": "ETH", "direction": "out", "amountAtomic": "500000000000000000" }
          ],
          "fiatFlow": { "direction": "received", "amountInrPaisa": "70000" },
          "gasFeeWei": "22000",
          "gasValueInrPaisa": "600"
        }
      ],
      "expected": {
        "categories": ["buy", "sell"],
        "positiveTaxableGainsInrPaisa": "20000",
        "vdaLossesInrPaisa": "0",
        "estimatedBaseTax30PercentInrPaisa": "6000",
        "estimatedCess4PercentInrPaisa": "240",
        "estimatedTaxIncludingCessInrPaisa": "6240",
        "excludedTransactions": 0,
        "remainingLot": {
          "symbol": "ETH",
          "quantityAtomic": "500000000000000000",
          "costBasisInrPaisa": "50000"
        },
        "disposal": {
          "costBasisInrPaisa": "50000",
          "taxableGainInrPaisa": "20000",
          "vdaLossInrPaisa": "0",
          "needsReview": false
        }
      }
    },
