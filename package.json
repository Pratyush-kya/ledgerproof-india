{
  "name": "ledgerproof-india",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "test:e2e:receipt": "playwright test --config playwright.receipt.config.ts",
    "contract:compile": "hardhat compile",
    "contract:test": "hardhat test solidity",
    "contract:deploy:base-sepolia": "hardhat run --network baseSepolia scripts/deploy-report-receipt.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.55.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "3.0.8",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "hardhat": "3.11.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
